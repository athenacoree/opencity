  "story": {
    "title": "Una carrera contra el tiempo",
    "intro": "El protagonista vuelve a Güira de Melena y descubre que su padre está ingresado en el hospital. La familia necesita dinero para los gastos y para organizar un traslado. Desbordado, llama a su amigo de confianza. Cuando el amigo llega a casa, ambos comprenden que tendrán que apoyarse, buscar trabajo y tomar decisiones difíciles para salir adelante. El nombre del amigo lo eliges tú.",
    "missions": [
      {
        "id": "hospital_news",
        "title": "Una llamada del hospital",
        "description": "Ve al hospital, habla con el personal médico y averigua qué necesita tu padre y cuánto tiempo tienes.",
        "reward_cup": 250,
        "objective_type": "visit_hospital"
      },
      {
        "id": "friend_arrives",
        "title": "Un amigo de verdad",
        "description": "Escribe el nombre de tu amigo, encuéntralo en casa y hablen sobre cómo conseguir el dinero necesario.",
        "reward_cup": 200,
        "objective_type": "meet_friend"
      },
      {
        "id": "rental_motorbike",
        "title": "Una moto prestada",
        "description": "Ve al punto de alquiler, habla con el encargado y alquila una moto para hacer los encargos del día.",
        "reward_cup": 350,
        "objective_type": "rent_motorbike"
      },
      {
        "id": "urgent_deliveries",
        "title": "Carrera contra el tiempo",
        "description": "Completa entregas y trabajos legales por distintos barrios. Los apagones y la mala señal pueden cambiar tus planes.",
        "reward_cup": 900,
        "objective_type": "complete_deliveries"
      },
      {
        "id": "medical_supplies",
        "title": "Lo que hace falta",
        "description": "Consulta la lista indicada por el hospital y consigue los productos permitidos en una farmacia o comercio abierto.",
        "reward_cup": 600,
        "objective_type": "deliver_supplies"
      },
      {
        "id": "father_transfer",
        "title": "Llegar a tiempo",
        "description": "Organiza el traslado con el hospital y tu familia. Tus decisiones determinan cómo continúa la historia.",
        "reward_cup": 1000,
        "objective_type": "arrange_transfer"
      }
    ],
